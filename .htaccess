# Songwunsch -- Apache: every address goes through the front controller,
# nothing else is reachable from outside.
# Needs Apache 2.4 with mod_rewrite and AllowOverride FileInfo AuthConfig (or All).
# For nginx see docs/installation.md, section "Web server".

# Only index.php may be executed. Every other PHP file, the configuration,
# the SQL and translation files, the README and the docs stay hidden.
<FilesMatch "\.(php|sql|po|pot|md|ini|log|env)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# The live-update signal (assets/live.txt, see src/LiveSignal.php) is asked
# for every few seconds and must never be answered from a cache without
# asking: "no-cache" still allows the 304 that makes it cheap, it only forbids
# handing out a stored copy unchecked.
<IfModule mod_headers.c>
    <Files "live.txt">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Static assets and the robots.txt are delivered directly ...
    RewriteRule ^assets/ - [L]
    RewriteRule ^robots\.txt$ - [L]
    # ... everything else is the front controller's business; it answers
    # 404 for addresses it does not know.
    RewriteCond %{REQUEST_URI} !/index\.php$
    RewriteRule ^ index.php [L]
</IfModule>
