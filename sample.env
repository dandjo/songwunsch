# Create a copy as .env:  cp sample.env .env
# The .env is not under version control (see .gitignore).

PROJECT_NAME=songwunsch
TZ=Europe/Vienna
DOMAIN_NAME=songwunsch.localhost
# Sub-path the application lives under: with a leading slash, without a
# trailing one. / (default) puts it at the domain root,
# https://songwunsch.localhost/. For a sub-path: BASE_PATH=/songliste
BASE_PATH=/

# --- Database ----------------------------------------------------------
DB_NAME=songwunsch
DB_USER=songwunsch
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Host port for external clients (DBeaver, PhpStorm), on 127.0.0.1 only.
DB_PORT_HOST=3399

# --- First admin -------------------------------------------------------
AUTH_USER=Administrator
# Create the hash:  docker compose exec web php tools/hash.php 'MyPassword'
# The default corresponds to the password "Administrator" -- please change it.
AUTH_HASH='$2y$12$yj8cmii9zUipXmvTfcFUR.kZlaxBEVjHAVciYdvUBmQCd0ZD6vRKm'

# Show technical error messages (1 = yes, 0 = logged-in users only).
SHOW_ERRORS=1

# --- The project's own Traefik ("standalone" profile) -------------------
# Only used with:  docker compose --profile standalone up -d
# If another Traefik already occupies 80/443, set different ports here.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8081

# --- Deployment (tools/deploy.sh) ---------------------------------------
# SSH host or ~/.ssh/config alias of the web host, and the directory there
# that the application is synced into (relative to the SSH login's home).
DEPLOY_HOST=my-webhost
DEPLOY_DIR=public_html
