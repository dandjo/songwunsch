# The web server hands this folder out itself (see the .htaccess in the root),
# so nothing in it may ever be executed. The rule in the root grants
# index.php by name, which would otherwise apply here as well.
#
# The application writes nothing here: its one runtime file lives in state/,
# which refuses to serve anything but that file (state/.htaccess). What is in
# this folder is delivered as it was deployed.
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
