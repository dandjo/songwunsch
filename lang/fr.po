# ---- Wishing (public) ----------------------------------------------------------------

msgid "The room is closed right now."
msgstr "La salle est fermée pour le moment."

msgid "Thanks, your wish is in."
msgstr "Merci, votre souhait est enregistré."

msgid "That was very quick – please click “Wish” once more."
msgstr "C’était très rapide – veuillez cliquer encore une fois sur « Souhaiter »."

msgid "The page has been open for a long time – please reload it and wish again."
msgstr "La page est ouverte depuis longtemps – veuillez la recharger et souhaiter de nouveau."

msgid "One moment – please do not wish that quickly in a row."
msgstr "Un instant – merci de ne pas enchaîner les souhaits aussi vite."

msgid "“{title}” is already on the wish list."
msgstr "« {title} » est déjà sur la liste de souhaits."

msgid "“{title}” by {artist} is in."
msgstr "« {title} » de {artist} est enregistré."

msgid "The wish list is full – please try again later."
msgstr "La liste de souhaits est pleine – veuillez réessayer plus tard."

msgid "A lot of wishes are coming in right now – please try again in a moment."
msgstr "Beaucoup de souhaits arrivent en ce moment – veuillez réessayer dans un instant."

msgid "Enough wishes for the moment – please wait a little."
msgstr "Assez de souhaits pour le moment – veuillez patienter un peu."

msgid "Quite a few wishes have come from you this hour – please come back later."
msgstr "Vous avez déjà envoyé beaucoup de souhaits cette heure-ci – revenez plus tard."

# ---- Song form -----------------------------------------------------------------------

msgid "The audience can pick the song right away."
msgstr "Le public peut choisir le morceau immédiatement."

msgid "Wishes already received keep their previous wording."
msgstr "Les souhaits déjà reçus gardent leur libellé d’origine."

msgid "(optional)"
msgstr "(facultatif)"

msgid "As m:ss (3:45) or in seconds (225). Stored in seconds."
msgstr "Au format m:ss (3:45) ou en secondes (225). Enregistré en secondes."

msgid "Add"
msgstr "Ajouter"

msgid "Save"
msgstr "Enregistrer"

msgid "Cancel"
msgstr "Annuler"

msgid "{field} is required."
msgstr "{field} est obligatoire."

msgid "{field} is too long: at most {max} characters."
msgstr "{field} est trop long : {max} caractères au maximum."

msgid "Length not understood. Examples: 3:45 or 225 (seconds)."
msgstr "Durée incomprise. Exemples : 3:45 ou 225 (secondes)."

msgid "Length is unrealistic – at most 23:59:59."
msgstr "Durée irréaliste – 23:59:59 au maximum."

msgid "This song was not found."
msgstr "Ce morceau n’a pas été trouvé."

msgid "Please check the highlighted fields."
msgstr "Veuillez vérifier les champs signalés."

msgid "“{title}” by {artist} has been added to the repertoire."
msgstr "« {title} » de {artist} a été ajouté au répertoire."

msgid "“{title}” by {artist} has been saved."
msgstr "« {title} » de {artist} a été enregistré."

msgid "“{title}” has been removed from the repertoire. Wishes already received are kept."
msgstr "« {title} » a été retiré du répertoire. Les souhaits déjà reçus sont conservés."

# ---- Login and access ----------------------------------------------------------------

msgid "Editing the wish list, the songs and the users is reserved for staff."
msgstr "La modification de la liste de souhaits, des morceaux et des utilisateurs est réservée à l’équipe."

msgid "Username"
msgstr "Nom d’utilisateur"

msgid "Password"
msgstr "Mot de passe"

msgid "Logged in as {name}."
msgstr "Connecté en tant que {name}."

msgid "Username or password is incorrect."
msgstr "Nom d’utilisateur ou mot de passe incorrect."

msgid "Please log in first."
msgstr "Veuillez d’abord vous connecter."

msgid "You do not have permission for that."
msgstr "Vous n’avez pas l’autorisation pour cela."

msgid "Session expired. Please reload the page."
msgstr "Session expirée. Veuillez recharger la page."

msgid "The session has expired. Please try again."
msgstr "La session a expiré. Veuillez réessayer."

msgid "An error occurred: {detail}"
msgstr "Une erreur s’est produite : {detail}"

msgid "The repertoire is not available right now. Please try again later."
msgstr "Le répertoire n’est pas disponible pour le moment. Veuillez réessayer plus tard."

msgid "The claw is stuck"
msgstr "Le bras du juke-box est coincé"

msgid "Check the database credentials in {config}. The application creates its tables itself; if the database user is not allowed to, use {schema}."
msgstr "Vérifiez les identifiants de la base de données dans {config}. L’application crée ses tables elle-même ; si l’utilisateur de la base n’y est pas autorisé, utilisez {schema}."

msgid "Database connection failed: {code}"
msgstr "Échec de la connexion à la base de données : {code}"

msgid "Table \"{table}\" does not have the expected structure, the columns {columns} are missing. If it comes from an older version, rename it or recreate it from sql/schema.sql."
msgstr "La table « {table} » n’a pas la structure attendue, les colonnes {columns} manquent. Si elle provient d’une ancienne version, renommez-la ou recréez-la à partir de sql/schema.sql."

# ---- Users ---------------------------------------------------------------------------

msgid "{n} user."
msgid_plural "{n} users."
msgstr[0] "{n} utilisateur."
msgstr[1] "{n} utilisateurs."

msgid "{editor} maintains the repertoire, {moderator} the wish list; the {admin} manages users and may do everything. There is exactly one admin; the role is handed over when editing a user."
msgstr "La {editor} gère le répertoire, la {moderator} la liste de souhaits ; l’{admin} gère les utilisateurs et peut tout faire. Il y a exactement un admin ; le rôle se transmet en modifiant un utilisateur."

msgid "Add user"
msgstr "Ajouter un utilisateur"

msgid "Edit user"
msgstr "Modifier l’utilisateur"

msgid "Users with roles and status"
msgstr "Utilisateurs avec rôles et statut"

msgid "Roles"
msgstr "Rôles"

msgid "Status"
msgstr "Statut"

msgid "(you)"
msgstr "(vous)"

msgid "no role"
msgstr "aucun rôle"

msgid "active"
msgstr "actif"

msgid "locked"
msgstr "bloqué"

msgid "Permanently delete user “{name}”?"
msgstr "Supprimer définitivement l’utilisateur « {name} » ?"

msgid "Pass on username and password – the new user can log in right away."
msgstr "Transmettez le nom d’utilisateur et le mot de passe – le nouvel utilisateur peut se connecter immédiatement."

msgid "The admin may do everything; their role boxes and status are therefore fixed. The admin role can be handed over to another user below."
msgstr "L’admin peut tout faire ; ses cases de rôle et son statut sont donc figés. Le rôle d’admin peut être transmis à un autre utilisateur ci-dessous."

msgid "Changes to roles and status take effect immediately, even for a running session."
msgstr "Les changements de rôles et de statut prennent effet immédiatement, même pour une session en cours."

msgid "New password"
msgstr "Nouveau mot de passe"

msgid "(leave empty to keep it)"
msgstr "(laisser vide pour le conserver)"

msgid "At least {n} characters."
msgstr "Au moins {n} caractères."

msgid "Repeat password"
msgstr "Répéter le mot de passe"

msgid "maintain the repertoire (add, edit, delete)"
msgstr "gérer le répertoire (ajouter, modifier, supprimer)"

msgid "edit the wish list, open and close the room"
msgstr "gérer la liste de souhaits, ouvrir et fermer la salle"

msgid "As admin this user has every permission anyway."
msgstr "En tant qu’admin, cet utilisateur a de toute façon tous les droits."

msgid "Active"
msgstr "Actif"

msgid "locked users cannot log in and are dropped from running sessions"
msgstr "les utilisateurs bloqués ne peuvent pas se connecter et sont exclus des sessions en cours"

msgid "Create"
msgstr "Créer"

msgid "Hand over admin role"
msgstr "Transmettre le rôle d’admin"

msgid "Afterwards {name} manages the users and may do everything. You keep your other roles but lose access to this page – you only get it back if the new admin hands the role back."
msgstr "Ensuite, {name} gère les utilisateurs et peut tout faire. Vous gardez vos autres rôles mais perdez l’accès à cette page – vous ne le retrouverez que si le nouvel admin vous rend le rôle."

msgid "Really hand the admin role over to “{name}”?"
msgstr "Vraiment transmettre le rôle d’admin à « {name} » ?"

msgid "Username: {min} to {max} characters."
msgstr "Nom d’utilisateur : de {min} à {max} caractères."

msgid "Username: letters, digits, dot, underscore, hyphen or @."
msgstr "Nom d’utilisateur : lettres, chiffres, point, tiret bas, tiret ou @."

msgid "This username is already taken."
msgstr "Ce nom d’utilisateur est déjà pris."

msgid "Password: at least {min} characters."
msgstr "Mot de passe : au moins {min} caractères."

msgid "The two passwords do not match."
msgstr "Les deux mots de passe ne correspondent pas."

msgid "This user is already the admin."
msgstr "Cet utilisateur est déjà l’admin."

msgid "This user was not found."
msgstr "Cet utilisateur n’a pas été trouvé."

msgid "The admin role can only be handed over to an active user."
msgstr "Le rôle d’admin ne peut être transmis qu’à un utilisateur actif."

msgid "The admin role could not be handed over."
msgstr "Le rôle d’admin n’a pas pu être transmis."

msgid "User “{name}” has been created."
msgstr "L’utilisateur « {name} » a été créé."

msgid "User “{name}” has been saved."
msgstr "L’utilisateur « {name} » a été enregistré."

msgid "User “{name}” has been deleted."
msgstr "L’utilisateur « {name} » a été supprimé."

msgid "The admin cannot be deleted – hand over the admin role first."
msgstr "L’admin ne peut pas être supprimé – transmettez d’abord le rôle d’admin."

msgid "Deleting was not possible."
msgstr "La suppression n’a pas été possible."

msgid "The admin role now belongs to “{name}”. You keep your other roles."
msgstr "Le rôle d’admin appartient maintenant à « {name} ». Vous gardez vos autres rôles."

msgid "Page not found"
msgstr "Page introuvable"

msgid "There is nothing at this address."
msgstr "Il n’y a rien à cette adresse."

msgid "To the repertoire"
msgstr "Vers le répertoire"

# --- Rooms ---------------------------------------------------------------

msgid "Rooms"
msgstr "Salles"

msgid "Room"
msgstr "Salle"

msgid "Main room"
msgstr "Salle principale"

msgid "always there"
msgstr "toujours là"

msgid "(current)"
msgstr "(actuelle)"


msgid "Address"
msgstr "Adresse"

msgid "Wishes"
msgstr "Souhaits"

msgid "{n} room besides the main room."
msgid_plural "{n} rooms besides the main room."
msgstr[0] "Une salle en plus de la salle principale."
msgstr[1] "{n} salles en plus de la salle principale."

msgid "Every room has its own repertoire, picked from the master list, and its own wish list."
msgstr "Chaque salle a sa propre liste de morceaux, choisie dans la liste principale, et sa propre liste de souhaits."

msgid "Rooms with their number of songs"
msgstr "Salles avec leur nombre de morceaux"

msgid "Add room"
msgstr "Créer une salle"

msgid "Edit room"
msgstr "Modifier la salle"

msgid "A room gets its own address, its own repertoire picked from the master list and its own wish list."
msgstr "Une salle reçoit sa propre adresse, sa propre liste de morceaux choisie dans la liste principale et sa propre liste de souhaits."

msgid "Changing the machine name changes the address – links already handed out stop working."
msgstr "Modifier le nom machine change l’adresse – les liens déjà distribués ne fonctionnent plus."

msgid "Name"
msgstr "Nom"

msgid "Shown in the header and the list of rooms, e.g. “Summer party 2026”."
msgstr "Affiché dans l’en-tête et la liste des salles, p. ex. « Fête d’été 2026 »."

msgid "Machine name"
msgstr "Nom machine"

msgid "Part of the address: lower-case letters a–z, digits and hyphens."
msgstr "Partie de l’adresse : minuscules a–z, chiffres et tirets."

msgid "Machine name: {min} to {max} characters."
msgstr "Nom machine : de {min} à {max} caractères."

msgid "Machine name: lower-case letters a–z, digits and hyphens, e.g. “sommerfest-2026”."
msgstr "Nom machine : minuscules a–z, chiffres et tirets, p. ex. « fete-ete-2026 »."

msgid "This machine name is already taken."
msgstr "Ce nom machine est déjà pris."

msgid "This room was not found."
msgstr "Cette salle n’a pas été trouvée."

msgid "Room “{name}” has been created. Now pick its songs from the master list."
msgstr "La salle « {name} » a été créée. Choisissez maintenant ses morceaux dans la liste principale."

msgid "Room “{name}” has been saved."
msgstr "La salle « {name} » a été enregistrée."

msgid "Room “{name}” has been deleted together with its wishes."
msgstr "La salle « {name} » a été supprimée avec ses souhaits."

msgid "Permanently delete room “{name}” together with its wishes?"
msgstr "Supprimer définitivement la salle « {name} » avec ses souhaits ?"

msgid "The main room always offers the whole repertoire."
msgstr "La salle principale propose toujours toute la liste de morceaux."

msgid "Manage the room: pick its songs from the master list."
msgstr "Gérer la salle : choisir ses morceaux dans la liste principale."

msgid "This room has no songs yet."
msgstr "Cette salle n’a pas encore de morceaux."

msgid "in this room."
msgstr "dans cette salle."

msgid "Remove"
msgstr "Retirer"

msgid "Songs of the room"
msgstr "Morceaux de la salle"

msgid "Remove every song from this room? Wishes already received are kept."
msgstr "Retirer tous les morceaux de cette salle ? Les souhaits déjà reçus sont conservés."

msgid "{n} song added to the room."
msgid_plural "{n} songs added to the room."
msgstr[0] "Un morceau ajouté à la salle."
msgstr[1] "{n} morceaux ajoutés à la salle."

msgid "{n} song removed from the room."
msgid_plural "{n} songs removed from the room."
msgstr[0] "Un morceau retiré de la salle."
msgstr[1] "{n} morceaux retirés de la salle."

msgid "Switch room"
msgstr "Changer de salle"

msgid "Manage {room}"
msgstr "Gérer {room}"

msgid "{n} of {total} songs are in the room."
msgstr "{n} morceaux sur {total} sont dans la salle."

msgid "Move songs with the arrows: to the right into the room, to the left out of it. The search filters both columns."
msgstr "Déplacez les morceaux avec les flèches : vers la droite dans la salle, vers la gauche pour les retirer. La recherche filtre les deux colonnes."

msgid "Master list"
msgstr "Liste principale"

msgid "Master list: songs not yet in the room"
msgstr "Liste principale : morceaux pas encore dans la salle"

msgid "Songs in the room"
msgstr "Morceaux dans la salle"

msgid "Every song of the master list is in the room."
msgstr "Tous les morceaux de la liste principale sont dans la salle."

msgid "Add all {n}"
msgstr "Ajouter les {n}"

msgid "Remove all {n}"
msgstr "Retirer les {n}"

msgid "{n} song available"
msgid_plural "{n} songs available"
msgstr[0] "Un morceau disponible"
msgstr[1] "{n} morceaux disponibles"

msgid "{n} song in the room"
msgid_plural "{n} songs in the room"
msgstr[0] "Un morceau dans la salle"
msgstr[1] "{n} morceaux dans la salle"

msgid "Add the {n} song found"
msgid_plural "Add all {n} songs found"
msgstr[0] "Ajouter le morceau trouvé"
msgstr[1] "Ajouter les {n} morceaux trouvés"

msgid "Remove the {n} song found"
msgid_plural "Remove all {n} songs found"
msgstr[0] "Retirer le morceau trouvé"
msgstr[1] "Retirer les {n} morceaux trouvés"

msgid "Manage"
msgstr "Gérer"

msgid "{n} room found for “{q}”."
msgid_plural "{n} rooms found for “{q}”."
msgstr[0] "Une salle trouvée pour « {q} »."
msgstr[1] "{n} salles trouvées pour « {q} »."

msgid "{n} archived room."
msgid_plural "{n} archived rooms."
msgstr[0] "Une salle archivée."
msgstr[1] "{n} salles archivées."

msgid "Archived rooms stay reachable through their address but leave the room switcher and the guests’ list."
msgstr "Les salles archivées restent accessibles par leur adresse mais disparaissent du sélecteur de salle et de la liste des visiteurs."

msgid "Search rooms"
msgstr "Rechercher des salles"

msgid "Room name or machine name …"
msgstr "Nom de la salle ou nom machine …"

msgid "Filter"
msgstr "Filtre"

msgid "Show:"
msgstr "Afficher :"

msgid "Archived"
msgstr "Archivées"

msgid "All"
msgstr "Toutes"

msgid "No room found. Try a different spelling?"
msgstr "Aucune salle trouvée. Une autre orthographe ?"

msgid "No archived rooms."
msgstr "Aucune salle archivée."

msgid "archived"
msgstr "archivée"

msgid "archived rooms leave the room switcher and the guests’ list but stay reachable through their address"
msgstr "les salles archivées disparaissent du sélecteur de salle et de la liste des visiteurs, mais restent accessibles par leur adresse"

msgid "Filter rooms"
msgstr "Filtrer les salles"

msgid "Filter …"
msgstr "Filtrer …"

msgid "No room matches."
msgstr "Aucune salle ne correspond."

msgid "Room “{name}” has been archived and closed."
msgstr "La salle « {name} » a été archivée et fermée."

msgid "Close all rooms"
msgstr "Fermer toutes les salles"

msgid "Lift the closing of all rooms"
msgstr "Lever la fermeture de toutes les salles"

msgid "The main room and every room are closed."
msgstr "La salle principale et toutes les salles sont fermées."

msgid "The closing is lifted; every room is back to the state it had before."
msgstr "La fermeture est levée ; chaque salle a retrouvé son état précédent."

msgid "Account: signed in as {name}"
msgstr "Compte : connecté en tant que {name}"

msgid "Account: {name}, guest view on"
msgstr "Compte : {name}, vue visiteur active"

msgid "View as guest"
msgstr "Voir comme visiteur"

msgid "End guest view"
msgstr "Quitter la vue visiteur"

msgid "Guest view."
msgstr "Vue visiteur."

msgid "You see the site as a visitor without a login does."
msgstr "Vous voyez le site tel qu’un visiteur non connecté le voit."

msgid "You now see the site as a guest does. Your own view is back in the account menu."
msgstr "Vous voyez maintenant le site comme un visiteur. Votre propre vue se retrouve dans le menu du compte."

msgid "Back to your own view."
msgstr "Retour à votre propre vue."

msgid "Account: not signed in"
msgstr "Compte : non connecté"

msgid "Signed in as"
msgstr "Connecté en tant que"

msgid "{n} wish"
msgid_plural "{n} wishes"
msgstr[0] "{n} souhait"
msgstr[1] "{n} souhaits"

msgid "The admin account still uses the default password."
msgstr "Le compte admin utilise encore le mot de passe par défaut."

msgid "Anyone who knows this software can sign in – {change}."
msgstr "Quiconque connaît ce logiciel peut se connecter – {change}."

msgid "change it now"
msgstr "le changer maintenant"

msgid "{room} is closed right now."
msgstr "{room} est fermée pour le moment."

# ---- Settings -----------------------------------------------------------------------------

msgid "Settings"
msgstr "Paramètres"

msgid "Settings saved."
msgstr "Paramètres enregistrés."

msgid "Personal – these settings apply to your own account only."
msgstr "Personnel – ces paramètres ne s’appliquent qu’à votre propre compte."

msgid "Your account has no role that may delete anything, so there is nothing to set here."
msgstr "Votre compte n’a aucun rôle autorisé à supprimer ; il n’y a donc rien à régler ici."

msgid "Delete confirmations"
msgstr "Confirmations de suppression"

msgid "Ask before deleting – switch off what gets in the way of routine work."
msgstr "Demander avant de supprimer – désactivez ce qui gêne le travail courant."

msgid "Confirm deleting songs"
msgstr "Confirmer la suppression de morceaux"

msgid "Delete in the repertoire"
msgstr "Supprimer dans le répertoire"

msgid "Confirm deleting wishes"
msgstr "Confirmer la suppression de souhaits"

msgid "Delete in the wish list – Clear list always asks"
msgstr "Supprimer dans la liste de souhaits – Vider la liste demande toujours"

msgid "Confirm deleting rooms"
msgstr "Confirmer la suppression de salles"

msgid "Delete under Rooms – the room’s wishes go with it"
msgstr "Supprimer sous Salles – les souhaits de la salle partent avec"

# ---- Guest name (the visitor's name for the wish list) -------------------------------------

msgid "Welcome! What is your name?"
msgstr "Bienvenue ! Comment t’appelles-tu ?"

msgid "Your name"
msgstr "Ton nom"

msgid "First name or nickname"
msgstr "Prénom ou surnom"

msgid "It appears on the wish list next to every song you wish for, visible to everyone in the room."
msgstr "Il apparaît dans la liste de souhaits à côté de chaque chanson que tu souhaites, visible par tout le monde dans la salle."

msgid "It is kept in this browser for a year and can be changed any time in the account menu at the top right."
msgstr "Il est conservé un an dans ce navigateur et peut être modifié à tout moment dans le menu du compte, en haut à droite."

msgid "Leave the field empty to wish without a name."
msgstr "Laisse le champ vide pour souhaiter sans nom."

msgid "Save name"
msgstr "Enregistrer le nom"

msgid "Not now"
msgstr "Pas maintenant"

msgid "Back"
msgstr "Retour"

msgid "Hello {name}! Your wishes now carry your name."
msgstr "Bonjour {name} ! Tes souhaits portent désormais ton nom."

msgid "Your wishes now carry no name."
msgstr "Tes souhaits ne portent désormais aucun nom."

msgid "Your wishes currently carry the name “{name}”."
msgstr "Tes souhaits portent actuellement le nom « {name} »."

msgid "Your wishes currently carry no name."
msgstr "Tes souhaits ne portent actuellement aucun nom."

msgid "Account: not signed in, wishing as {name}"
msgstr "Compte : non connecté, souhaite en tant que {name}"

msgid "Your name on the wish list:"
msgstr "Ton nom dans la liste de souhaits :"

msgid "No name yet"
msgstr "Pas encore de nom"

msgid "Set name"
msgstr "Définir le nom"

msgid "Change name"
msgstr "Modifier le nom"

msgid "Name for wishes"
msgstr "Nom pour les souhaits"

msgid "Wishing as {name}"
msgstr "Souhaite en tant que {name}"

msgid "From"
msgstr "De"

msgid "No name given"
msgstr "Aucun nom indiqué"

# ---- Song suggestions ------------------------------------------------------------------

msgid "Suggestions"
msgstr "Suggestions"

msgid "Song suggestions"
msgstr "Suggestions de morceaux"

msgid "{n} open suggestion"
msgid_plural "{n} open suggestions"
msgstr[0] "{n} suggestion en attente"
msgstr[1] "{n} suggestions en attente"

msgid "{n} suggestion waiting."
msgid_plural "{n} suggestions waiting."
msgstr[0] "{n} suggestion en attente."
msgstr[1] "{n} suggestions en attente."

msgid "Adopt puts the song on the list and onto the wish list once you have added what is missing; Delete drops the suggestion."
msgstr "Reprendre ajoute le morceau à la liste et à la liste de souhaits une fois les informations manquantes complétées ; Supprimer écarte la suggestion."

msgid "Missing a song? Name it here – the editors decide whether it joins the repertoire."
msgstr "Un morceau manque ? Indiquez-le ici – la rédaction décide s’il rejoint la liste."

msgid "{n} suggestion is waiting for the editors."
msgid_plural "{n} suggestions are waiting for the editors."
msgstr[0] "{n} suggestion attend la rédaction."
msgstr[1] "{n} suggestions attendent la rédaction."

msgid "Really delete all suggestions?"
msgstr "Vraiment supprimer toutes les suggestions ?"

msgid "Suggest a song"
msgstr "Suggérer un morceau"

msgid "Suggest"
msgstr "Suggérer"

msgid "Your name, {name}, goes with the suggestion so the editors know who asked."
msgstr "Votre nom, {name}, accompagne la suggestion pour que la rédaction sache qui l’a demandée."

msgid "The suggestion is passed on without a name; set one in the account menu if you like."
msgstr "La suggestion est transmise sans nom ; vous pouvez en indiquer un dans le menu du compte."

msgid "No suggestions yet. The audience has everything it needs – or has not found the form."
msgstr "Pas encore de suggestion. Le public a tout ce qu’il lui faut – ou n’a pas encore trouvé le formulaire."

msgid "Open song suggestions, oldest first, with who suggested them"
msgstr "Suggestions de morceaux en attente, les plus anciennes d’abord, avec le nom de qui les a faites"

msgid "Adopt"
msgstr "Reprendre"

msgid "Delete the suggestion “{title}”?"
msgstr "Supprimer la suggestion « {title} » ?"

msgid "Adopt suggestion"
msgstr "Reprendre la suggestion"

msgid "Artist and title come from the suggestion – check them and add length and genre. The song goes on the list and straight onto the wish list, the suggestion off it."
msgstr "L’artiste et le titre viennent de la suggestion – vérifiez-les et ajoutez la durée et le genre. Le morceau rejoint la liste et passe directement sur la liste de souhaits, la suggestion disparaît."

msgid "Thanks, your suggestion is in."
msgstr "Merci, votre suggestion est enregistrée."

msgid "That was very quick – please click “Suggest” once more."
msgstr "C’était très rapide – veuillez cliquer encore une fois sur « Suggérer »."

msgid "The page has been open for a long time – please reload it and suggest again."
msgstr "La page est ouverte depuis longtemps – veuillez la recharger et suggérer à nouveau."

msgid "One moment – please do not suggest that quickly in a row."
msgstr "Un instant – veuillez ne pas suggérer aussi vite d’affilée."

msgid "The suggestion box is full – please try again later."
msgstr "La boîte à suggestions est pleine – veuillez réessayer plus tard."

msgid "“{title}” by {artist} is already on the repertoire – you can wish for it right away."
msgstr "« {title} » de {artist} figure déjà dans la liste – vous pouvez le demander tout de suite."

msgid "“{title}” by {artist} has already been suggested."
msgstr "« {title} » de {artist} a déjà été suggéré."

msgid "Thanks! “{title}” by {artist} has been passed on to the editors."
msgstr "Merci ! « {title} » de {artist} a été transmis à la rédaction."

msgid "“{title}” by {artist} has been added to the repertoire, put on the wish list and taken off the suggestions."
msgstr "« {title} » de {artist} a été ajouté à la liste, placé sur la liste de souhaits et retiré des suggestions."

msgid "Suggestion deleted."
msgstr "Suggestion supprimée."

msgid "This suggestion was not found."
msgstr "Cette suggestion n’a pas été trouvée."

msgid "{n} suggestion deleted."
msgid_plural "{n} suggestions deleted."
msgstr[0] "{n} suggestion supprimée."
msgstr[1] "{n} suggestions supprimées."

msgid "Confirm deleting suggestions"
msgstr "Confirmer la suppression de suggestions"

msgid "Delete under Suggestions – Clear list always asks"
msgstr "Supprimer sous Suggestions – Vider la liste demande toujours"

msgid "A suggestion made in a room carries the room’s tag – the adopted song is offered there as well."
msgstr "Une suggestion faite dans une salle porte l’étiquette de la salle – le morceau repris y est aussi proposé."

msgid "Suggested from this room, the song is offered here once it is in."
msgstr "Suggéré depuis cette salle, le morceau y sera proposé une fois ajouté."

msgid "deleted room"
msgstr "salle supprimée"

msgid "It was suggested in room “{room}”, so the song is offered there as well."
msgstr "Il a été suggéré dans la salle « {room} » – le morceau y sera donc aussi proposé."

msgid "“{title}” by {artist} has been added to the repertoire and to room “{room}”, put on its wish list and taken off the suggestions."
msgstr "« {title} » de {artist} a été ajouté à la liste et à la salle « {room} », placé sur sa liste de souhaits et retiré des suggestions."

msgid "The room is closed right now – no wishes and no suggestions."
msgstr "La salle est fermée pour le moment – ni souhaits ni suggestions."

# ---- Open and closed rooms -------------------------------------------------------------

msgid "“{name}” is closed. The audience can see its repertoire but cannot wish or suggest anything there."
msgstr "« {name} » est fermée. Le public voit le répertoire mais ne peut y ni souhaiter ni suggérer."

msgid "“{name}” is open again."
msgstr "« {name} » est de nouveau ouverte."

msgid "The audience sees the repertoire but cannot wish or suggest anything."
msgstr "Le public voit le répertoire mais ne peut ni souhaiter ni suggérer."

msgid "Open it in the notice above or under {rooms}."
msgstr "Vous pouvez la rouvrir depuis l’avis ci-dessus ou sous {rooms}."

msgid "closed"
msgstr "fermée"

msgid "Move {label} to the top"
msgstr "Placer {label} tout en haut"

msgid "Move {label} to the bottom"
msgstr "Placer {label} tout en bas"

msgid "Search suggestions"
msgstr "Rechercher des suggestions"

msgid "Artist, title, name …"
msgstr "Artiste, titre, nom…"

msgid "{n} suggestion found for “{q}”."
msgid_plural "{n} suggestions found for “{q}”."
msgstr[0] "{n} suggestion trouvée pour « {q} »."
msgstr[1] "{n} suggestions trouvées pour « {q} »."

msgid "{n} suggestion waiting in total."
msgid_plural "{n} suggestions waiting in total."
msgstr[0] "{n} suggestion en attente au total."
msgstr[1] "{n} suggestions en attente au total."

msgid "No suggestion matches. Try a different spelling?"
msgstr "Aucune suggestion ne correspond. Une autre orthographe ?"

msgid "Open suggestions"
msgstr "Suggestions en attente"

msgid "No suggestions yet – yours could be the first."
msgstr "Pas encore de suggestion – la vôtre pourrait être la première."

msgid "The list has been updated."
msgstr "La liste a été mise à jour."

# ---- Main room name ----------------------------------------------------------------------

msgid "Rename"
msgstr "Renommer"

msgid "Rename the main room"
msgstr "Renommer la salle principale"

msgid "Shown in the header, the room switcher and the list of rooms wherever the main room is meant."
msgstr "Affiché dans l’en-tête, le sélecteur de salle et la liste des salles partout où la salle principale est désignée."

msgid "The main room has its default name again."
msgstr "La salle principale porte de nouveau son nom par défaut."

msgid "The main room is always there and lives at the root address; only its name can change. Leave the field empty for the default name."
msgstr "La salle principale existe toujours et se trouve à l’adresse racine ; seul son nom peut changer. Laissez le champ vide pour le nom par défaut."

msgid "The main room is now called “{name}”."
msgstr "La salle principale s’appelle désormais « {name} »."

# ---- Start room -----------------------------------------------------------------------------

msgid "As start room"
msgstr "Salle de départ"

msgid "start room"
msgstr "salle de départ"

msgid "New visitors now start in “{name}”."
msgstr "Les nouveaux visiteurs commencent désormais dans « {name} »."

msgid "New visitors start in the main room again."
msgstr "Les nouveaux visiteurs commencent de nouveau dans la salle principale."

msgid "There is no room at this address – here is the start page."
msgstr "Il n’y a pas de salle à cette adresse – voici la page d’accueil."

msgid "The start room receives visitors who open the bare address without having chosen a room yet; everyone else stays in the room they chose last."
msgstr "La salle de départ accueille les visiteurs qui ouvrent l’adresse nue sans avoir encore choisi de salle ; tous les autres restent dans la salle choisie en dernier."

msgid "Visitors who open the bare address without having chosen a room yet land in the main room; As start room sends them into another room instead."
msgstr "Les visiteurs qui ouvrent l’adresse nue sans avoir encore choisi de salle arrivent dans la salle principale ; « Salle de départ » les envoie dans une autre salle."
