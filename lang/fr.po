# ---- Wishing (public) ----------------------------------------------------------------

msgid "The room is closed right now."
msgstr "La salle est fermée pour le moment."

msgid "Thanks, your wish is in."
msgstr "Merci, votre souhait est enregistré."

msgid "That was very quick – please click “Wish” once more."
msgstr "C’était très rapide – veuillez cliquer encore une fois sur « Souhaiter »."

msgid "The page has been open for a long time – please reload it and wish again."
msgstr "La page est ouverte depuis longtemps – veuillez la recharger et souhaiter de nouveau."

msgid "One moment – please do not wish that quickly in a row."
msgstr "Un instant – merci de ne pas enchaîner les souhaits aussi vite."

msgid "“{title}” by {artist} is in."
msgstr "« {title} » de {artist} est enregistré."

msgid "The wish list is full – please try again later."
msgstr "La liste de souhaits est pleine – veuillez réessayer plus tard."

msgid "A lot of wishes are coming in right now – please try again in a moment."
msgstr "Beaucoup de souhaits arrivent en ce moment – veuillez réessayer dans un instant."

msgid "Enough wishes for the moment – please wait a little."
msgstr "Assez de souhaits pour le moment – veuillez patienter un peu."

msgid "Quite a few wishes have come from you this hour – please come back later."
msgstr "Vous avez déjà envoyé beaucoup de souhaits cette heure-ci – revenez plus tard."

# ---- Song form -----------------------------------------------------------------------

msgid "The audience can pick the song right away."
msgstr "Le public peut choisir le morceau immédiatement."

msgid "Wishes already received keep their previous wording."
msgstr "Les souhaits déjà reçus gardent leur libellé d’origine."

msgid "(optional)"
msgstr "(facultatif)"

msgid "As m:ss (3:45) or in seconds (225). Stored in seconds."
msgstr "Au format m:ss (3:45) ou en secondes (225). Enregistré en secondes."

msgid "Add"
msgstr "Ajouter"

msgid "Save"
msgstr "Enregistrer"

msgid "Cancel"
msgstr "Annuler"

msgid "{field} is required."
msgstr "{field} est obligatoire."

msgid "{field} is too long: at most {max} characters."
msgstr "{field} est trop long : {max} caractères au maximum."

msgid "Length not understood. Examples: 3:45 or 225 (seconds)."
msgstr "Durée incomprise. Exemples : 3:45 ou 225 (secondes)."

msgid "Length is unrealistic – at most 23:59:59."
msgstr "Durée irréaliste – 23:59:59 au maximum."

msgid "This song was not found."
msgstr "Ce morceau n’a pas été trouvé."

msgid "Please check the highlighted fields."
msgstr "Veuillez vérifier les champs signalés."

msgid "“{title}” by {artist} has been added to the repertoire."
msgstr "« {title} » de {artist} a été ajouté au répertoire."

msgid "“{title}” by {artist} has been saved."
msgstr "« {title} » de {artist} a été enregistré."

msgid "“{title}” has been removed from the repertoire. Wishes already received are kept."
msgstr "« {title} » a été retiré du répertoire. Les souhaits déjà reçus sont conservés."

# ---- Login and access ----------------------------------------------------------------

msgid "Editing the wish list, the songs and the users is reserved for staff."
msgstr "La modification de la liste de souhaits, des morceaux et des utilisateurs est réservée à l’équipe."

msgid "Username"
msgstr "Nom d’utilisateur"

msgid "Password"
msgstr "Mot de passe"

msgid "Logged in as {name}."
msgstr "Connecté en tant que {name}."

msgid "Username or password is incorrect."
msgstr "Nom d’utilisateur ou mot de passe incorrect."

msgid "Please log in first."
msgstr "Veuillez d’abord vous connecter."

msgid "You do not have permission for that."
msgstr "Vous n’avez pas l’autorisation pour cela."

msgid "Session expired. Please reload the page."
msgstr "Session expirée. Veuillez recharger la page."

msgid "The session has expired. Please try again."
msgstr "La session a expiré. Veuillez réessayer."

msgid "An error occurred: {detail}"
msgstr "Une erreur s’est produite : {detail}"

msgid "The repertoire is not available right now. Please try again later."
msgstr "Le répertoire n’est pas disponible pour le moment. Veuillez réessayer plus tard."

msgid "The claw is stuck"
msgstr "Le bras du juke-box est coincé"

msgid "Check the database credentials in {config}. The application creates its tables itself; if the database user is not allowed to, use {schema}."
msgstr "Vérifiez les identifiants de la base de données dans {config}. L’application crée ses tables elle-même ; si l’utilisateur de la base n’y est pas autorisé, utilisez {schema}."

msgid "Database connection failed: {code}"
msgstr "Échec de la connexion à la base de données : {code}"

msgid "Table \"{table}\" does not have the expected structure, the columns {columns} are missing. Rename it or recreate it from sql/schema.sql."
msgstr "La table « {table} » n’a pas la structure attendue, les colonnes {columns} manquent. Renommez-la ou recréez-la à partir de sql/schema.sql."

# ---- Users ---------------------------------------------------------------------------

msgid "{n} user."
msgid_plural "{n} users."
msgstr[0] "{n} utilisateur."
msgstr[1] "{n} utilisateurs."

msgid "{editor} maintains the repertoire, {moderator} the wish list; {admin} manages users, hands out every role and may do everything. Roles can be combined; at least one active admin always remains."
msgstr "{editor} gère le répertoire, {moderator} la liste de souhaits ; {admin} gère les utilisateurs, attribue tous les rôles et peut tout faire. Les rôles se combinent ; il reste toujours au moins un admin actif."

msgid "Add user"
msgstr "Ajouter un utilisateur"

msgid "Edit user"
msgstr "Modifier l’utilisateur"

msgid "Users with roles and status"
msgstr "Utilisateurs avec rôles et statut"

msgid "Roles"
msgstr "Rôles"

msgid "Status"
msgstr "Statut"

msgid "(you)"
msgstr "(vous)"

msgid "no role"
msgstr "aucun rôle"

msgid "active"
msgstr "actif"

msgid "locked"
msgstr "bloqué"

msgid "Permanently delete user “{name}”?"
msgstr "Supprimer définitivement l’utilisateur « {name} » ?"

msgid "Pass on username and password – the new user can log in right away."
msgstr "Transmettez le nom d’utilisateur et le mot de passe – le nouvel utilisateur peut se connecter immédiatement."

msgid "Changes to roles and status take effect immediately, even for a running session."
msgstr "Les changements de rôles et de statut prennent effet immédiatement, même pour une session en cours."

msgid "New password"
msgstr "Nouveau mot de passe"

msgid "(leave empty to keep it)"
msgstr "(laisser vide pour le conserver)"

msgid "At least {n} characters."
msgstr "Au moins {n} caractères."

msgid "Repeat password"
msgstr "Répéter le mot de passe"

msgid "maintain the repertoire, work the song suggestions, create rooms and manage their songs"
msgstr "gérer le répertoire, traiter les suggestions de chansons, créer des salles et gérer leurs chansons"

msgid "edit the wish list, close and open rooms"
msgstr "gérer la liste de souhaits, fermer et ouvrir les salles"

msgid "manage users and roles, logos, colours, limits, pages, footer and languages; includes Editor and Moderator"
msgstr "gérer les utilisateurs et les rôles, les logos, les couleurs, les limites, les pages, le pied de page et les langues ; inclut Rédaction et Modération"

msgid "The only active admin keeps the role – make another user admin first."
msgstr "Le seul admin actif garde son rôle – nommez d’abord un autre utilisateur admin."

msgid "You cannot lock yourself."
msgstr "Vous ne pouvez pas vous bloquer vous-même."

msgid "Active"
msgstr "Actif"

msgid "locked users cannot log in and are dropped from running sessions"
msgstr "les utilisateurs bloqués ne peuvent pas se connecter et sont exclus des sessions en cours"

msgid "Create"
msgstr "Créer"

msgid "Username: {min} to {max} characters."
msgstr "Nom d’utilisateur : de {min} à {max} caractères."

msgid "Username: letters, digits, dot, underscore, hyphen or @."
msgstr "Nom d’utilisateur : lettres, chiffres, point, tiret bas, tiret ou @."

msgid "This username is already taken."
msgstr "Ce nom d’utilisateur est déjà pris."

msgid "Password: at least {min} characters."
msgstr "Mot de passe : au moins {min} caractères."

msgid "The two passwords do not match."
msgstr "Les deux mots de passe ne correspondent pas."

msgid "This user was not found."
msgstr "Cet utilisateur n’a pas été trouvé."

msgid "User “{name}” has been created."
msgstr "L’utilisateur « {name} » a été créé."

msgid "User “{name}” has been saved."
msgstr "L’utilisateur « {name} » a été enregistré."

msgid "User “{name}” has been deleted."
msgstr "L’utilisateur « {name} » a été supprimé."

msgid "You cannot delete yourself."
msgstr "Vous ne pouvez pas vous supprimer vous-même."

msgid "You are the only active admin – make another user admin first."
msgstr "Vous êtes le seul admin actif – nommez d’abord un autre utilisateur admin."

msgid "Deleting was not possible."
msgstr "La suppression n’a pas été possible."

msgid "You are no longer admin. Your other roles stay; another admin can give the role back."
msgstr "Vous n’êtes plus admin. Vos autres rôles restent ; un autre admin peut vous rendre le rôle."

msgid "Page not found"
msgstr "Page introuvable"

msgid "There is nothing at this address."
msgstr "Il n’y a rien à cette adresse."


