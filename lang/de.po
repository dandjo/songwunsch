msgstr "Tabelle „{table}“ hat nicht die erwartete Struktur, es fehlen die Spalten {columns}. Stammt sie aus einer älteren Version, bitte umbenennen oder nach sql/schema.sql neu anlegen."

# ---- Users --------------------------------------------------------------------------------

msgid "{n} user."
msgid_plural "{n} users."
msgstr[0] "Ein Benutzer."
msgstr[1] "{n} Benutzer."

msgid "{editor} maintains the song list, {moderator} the wish list; the {admin} manages users and may do everything. There is exactly one admin; the role is handed over when editing a user."
msgstr "{editor} pflegt die Songliste, {moderator} die Wunschliste, der {admin} verwaltet die Benutzer und darf alles. Es gibt genau einen Admin; die Rolle wird beim Bearbeiten eines Benutzers übergeben."

