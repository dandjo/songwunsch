# ---- Wishing (public) ---------------------------------------------------------------

msgid "The room is closed right now."
msgstr "Der Raum ist gerade geschlossen."

msgid "Thanks, your wish is in."
msgstr "Danke, der Wunsch ist eingeworfen."

msgid "That was very quick – please click “Wish” once more."
msgstr "Das ging sehr schnell – bitte noch einmal auf „Wünschen“ klicken."

msgid "The page has been open for a long time – please reload it and wish again."
msgstr "Die Seite war lange geöffnet – bitte neu laden und noch einmal wünschen."

msgid "One moment – please do not wish that quickly in a row."
msgstr "Einen Moment noch – bitte nicht so schnell hintereinander wünschen."

msgid "“{title}” is already on the wish list."
msgstr "„{title}“ steht bereits auf der Wunschliste."

msgid "“{title}” by {artist} is in."
msgstr "„{title}“ von {artist} ist eingeworfen."

msgid "The wish list is full – please try again later."
msgstr "Die Wunschliste ist voll – bitte später noch einmal versuchen."

msgid "A lot of wishes are coming in right now – please try again in a moment."
msgstr "Gerade kommen sehr viele Wünsche an – bitte gleich noch einmal versuchen."

msgid "Enough wishes for the moment – please wait a little."
msgstr "Genug gewünscht für den Moment – bitte einen Augenblick warten."

msgid "Quite a few wishes have come from you this hour – please come back later."
msgstr "Für diese Stunde sind schon viele Wünsche von dir eingegangen – bitte später wieder."

# ---- Song form -----------------------------------------------------------------------

msgid "The audience can pick the song right away."
msgstr "Der Titel steht dem Publikum danach sofort zur Auswahl."

msgid "Wishes already received keep their previous wording."
msgstr "Bereits eingegangene Wünsche behalten ihren bisherigen Wortlaut."

msgid "(optional)"
msgstr "(optional)"

msgid "As m:ss (3:45) or in seconds (225). Stored in seconds."
msgstr "Als m:ss (3:45) oder in Sekunden (225). Gespeichert wird in Sekunden."

msgid "Add"
msgstr "Hinzufügen"

msgid "Save"
msgstr "Speichern"

msgid "Cancel"
msgstr "Abbrechen"

msgid "{field} is required."
msgstr "{field} ist erforderlich."

msgid "{field} is too long: at most {max} characters."
msgstr "{field} ist zu lang: höchstens {max} Zeichen."

msgid "Length not understood. Examples: 3:45 or 225 (seconds)."
msgstr "Länge nicht verstanden. Beispiele: 3:45 oder 225 (Sekunden)."

msgid "Length is unrealistic – at most 23:59:59."
msgstr "Länge ist unrealistisch – höchstens 23:59:59."

msgid "This song was not found."
msgstr "Dieser Song wurde nicht gefunden."

msgid "Please check the highlighted fields."
msgstr "Bitte die markierten Felder prüfen."

